# Database
MONGODB_URI_DEVELOPMENT=mongodb://localhost:27017/mr-trading-dev
MONGODB_DB_NAME_DEVELOPMENT=mr-trading

MONGODB_URI_PRODUCTION=mongodb+srv://username:password@cluster.mongodb.net/mr-trading-prod?retryWrites=true&w=majority
MONGODB_DB_NAME_PRODUCTION=mr-trading-prod

# Optional fallback for older deployments
MONGODB_URI=mongodb://localhost:27017/mr-trading-dev
MONGODB_DB_NAME=mr-trading-dev

# JWT
JWT_SECRET=your_jwt_secret_key_here_min_32_characters
JWT_EXPIRE=7d

# API
NEXT_PUBLIC_API_URL=http://localhost:3000
NODE_ENV=development

# Store Configuration
STORE_NAME=MR Trading
STORE_CURRENCY=USD
STORE_TAX_RATE=10
